# ============================================================================
# EDUCA - Environment Template for the Public Demo Sandbox (issue #23)
# ============================================================================
# Copy the values into the Vercel project environment of the demo instance
# (demo.educa.app.br) and export the reset variables in the local shell that
# runs app/scripts/demo-reset.sh. Full runbook: DEMO.md.
#
# All values marked SECRET must never be committed or rendered client-side.
# ============================================================================

# -------------------------
# SUPABASE (demo project)
# -------------------------
# Public URL of the dedicated demo Supabase project (educa-demo).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Public anon key (client-safe, RLS-bound). Signups are disabled at the
# project level: Authentication > Providers > Email > "Allow new users to
# sign up" = OFF (see DEMO.md).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Service role key - SECRET. Used only server-side by seed scripts and the
# admin API. Export only in the local reset shell.
SUPABASE_DEMO_SERVICE_KEY=<service role key>

# Direct Postgres connection string (postgres role) - SECRET. Used by the
# reset transaction. Prefer the transaction pooler URL
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Export only in the local reset shell.
SUPABASE_DEMO_DB_URL=<postgres connection string>

# Alias used by `pnpm seed:demo` and `pnpm demo:validate` (same value as
# NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_DEMO_URL=https://<ref>.supabase.co

# -------------------------
# DEMO SANDBOX MODE
# -------------------------
# Switches the instance into public demo sandbox mode: hides destructive
# actions, blocks admin data-management APIs, shows the demo banner.
NEXT_PUBLIC_DEMO_SANDBOX=true
DEMO_SANDBOX=true

# -------------------------
# SYNTHETIC PILOT FOUNDATION (keep these values - see CONTEXT.md)
# -------------------------
# The demo instance is a synthetic-only pilot foundation instance: it never
# holds real student/family data and external deploy remains blocked.
NEXT_PUBLIC_PILOT_MODE=true
PILOT_MODE=true
PILOT_SYNTHETIC_DATA_ONLY=true
PILOT_EXTERNAL_DEPLOY_APPROVED=false
PILOT_LEGAL_APPROVAL_STATUS=not_approved
PILOT_IMPORT_ENCRYPTION_KEY=
PILOT_IMPORT_ENCRYPTION_KEY_ID=synthetic-demo-v1

# -------------------------
# DEMO CREDENTIALS (issue #23 - fixed login)
# -------------------------
# Only used by the seed runner; do not change without updating DEMO.md.
DEMO_EMAIL=demo@educa.app.br
DEMO_PASSWORD=Demo@2026

# -------------------------
# APPLICATION
# -------------------------
NODE_ENV=production
