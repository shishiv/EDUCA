# ============================================================================
# EDUCA - Sistema de Gestão Escolar Municipal
# Environment Variables Template
# ============================================================================
# Copy this file to .env.local and fill in the values
# cp .env.local.example .env.local
# ============================================================================

# =========================
# SUPABASE CONFIGURATION
# =========================

# Public Supabase URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anon Key (safe for client-side, respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (SERVER-SIDE ONLY - bypasses RLS)
# Required for: seed scripts, admin operations, auth.admin methods
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Synthetic municipal pilot foundation. Keep these values until named municipal
# governance approvals exist. The import key must be a base64-encoded 32-byte key.
NEXT_PUBLIC_PILOT_MODE=true
PILOT_MODE=true
PILOT_SYNTHETIC_DATA_ONLY=true
PILOT_EXTERNAL_DEPLOY_APPROVED=false
PILOT_LEGAL_APPROVAL_STATUS=not_approved
PILOT_IMPORT_ENCRYPTION_KEY=
PILOT_IMPORT_ENCRYPTION_KEY_ID=synthetic-local-v1

# Bounded descriptive-report PDF rehearsal. Keep disabled outside the isolated
# `pnpm test:e2e:pilot:descriptive` command, which sets both flags itself.
NEXT_PUBLIC_PILOT_DESCRIPTIVE_REPORT_DEMO=false
PILOT_DESCRIPTIVE_REPORT_DEMO=false

# =========================
# APPLICATION SETTINGS
# =========================

# Environment: development | staging | production
NODE_ENV=development

# =========================
# WHATSAPP ATTENDANCE NOTIFICATIONS (bounded MVP)
# =========================
# External delivery is a later explicit approval. While PILOT_MODE=true or
# any credential below is empty, every send runs on the deterministic local
# fake and writes masked receipts to .pilot-evidence/whatsapp-receipts.jsonl.
# Never put real Meta credentials here without that approval.
WHATSAPP_META_ENABLED=false
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
# Graph API version used by the Meta adapter (official default).
# WHATSAPP_GRAPH_API_VERSION=v23.0
# Local fake rehearsal: deliver | fail | reject
WHATSAPP_LOCAL_FAKE_MODE=deliver
# Retry policy for transient delivery failures.
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_RETRY_BASE_DELAY_MS=60000

# ============================================================================
# PRODUCTION VALUES (for reference - get from Supabase dashboard)
# ============================================================================
# Project URL: Settings > Project Settings > API > Project URL
# Anon Key: Settings > Project Settings > API > anon public
# Service Role Key: Settings > Project Settings > API > service_role (secret)
# ============================================================================

# =========================
# MUNICIPAL IDENTITY
# =========================

# Name of the municipality
NEXT_PUBLIC_MUNICIPAL_NAME=Nome do Município

# Name of the education secretariat
NEXT_PUBLIC_SECRETARIA_NAME=Secretaria Municipal de Educação

# State abbreviation (UF)
NEXT_PUBLIC_MUNICIPAL_STATE=UF

# Support contact phone
NEXT_PUBLIC_CONTACT_PHONE=

# DPO (Data Protection Officer) e-mail
NEXT_PUBLIC_DPO_EMAIL=

# DPO address (for privacy policy)
NEXT_PUBLIC_DPO_ADDRESS=
